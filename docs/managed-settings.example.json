{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -r:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.config/cgai/**)",
      "Bash(security:*)",
      "Bash(env)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(set)",
      "Bash(export -p)",
      "Bash(echo $NOTION_TOKEN:*)",
      "Bash(echo ${NOTION_TOKEN}:*)",
      "Bash(powershell:*)",
      "Bash(pwsh:*)",
      "Bash(cmd:*)",
      "Bash(cmd.exe:*)",
      "Bash(reg:*)",
      "Bash(setx:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "allowUnsandboxedCommands": false,
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.config/cgai",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "NOTION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        }
      ]
    }
  }
}